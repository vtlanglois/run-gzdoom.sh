# Path to your GZDoom executable
# Can include multiple paths for multiple GZDoom version
# Format: 
# - Single "/path/to/gzdoom"
# - Multiple: "Display Name|/path/to/gzdoom"
GZDOOM_PATH="$HOME/Games/gzdoom/gzdoom"

# Path to your IWAD (base game)
IWAD_PATH="$HOME/Games/doom/doom2.wad"

# Mods — add as many as you want
# Format: "Display Name|/path/to/file.pk3"
MODS=(
  "Brutal Doom|$HOME/mods/brutal.pk3"
  "Vanilla|none"
)